{
    "name": "php2shell/symfony-8321-lab",
    "description": "Real Symfony 7.4.19 application for the PHP 8.3.21 isolated lab",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3.21 <8.4",
        "symfony/console": "7.4.19",
        "symfony/framework-bundle": "7.4.19",
        "symfony/http-foundation": "7.4.19",
        "symfony/http-kernel": "7.4.19",
        "symfony/twig-bundle": "7.4.19",
        "symfony/web-profiler-bundle": "7.4.19",
        "symfony/yaml": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.21"
        },
        "sort-packages": true
    }
}
